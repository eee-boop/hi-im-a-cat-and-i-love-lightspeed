{
  "manifest_version": 3,
  "name": "Lightspeed Filter Helper",
  "description": "Lightspeed Filter Helper for Chrome",
  "version": "1.3.8.1788379673",
  "action": {
    "default_popup": "action.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "128": "assets/icon-128-c.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "identity",
    "identity.email",
    "offscreen",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "assets/*",
        "main.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "update_url": "https://lsrelay-extensions-production.s3.amazonaws.com/FilterHelper/ebddd4debb15b1ea88b4a4160a063135647f3b3c08b233d64392ceb928dbd068/FilterHelperAgent.xml"
}